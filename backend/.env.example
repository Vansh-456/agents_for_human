# AWS Configuration
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=... # Set via environment or IAM role
# AWS_SECRET_ACCESS_KEY=... # Set via environment or IAM role

# Amazon Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Data Layer (DynamoDB & S3)
DYNAMODB_TABLE_NAME=AnnaSetuStateTable
S3_BUCKET_NAME=annasetu-event-archive

# Environment Flags
MOCK_AWS=true # Set to false in production
MOCK_WHATSAPP=true
MOCK_LOCATION=true

# WhatsApp Cloud API (Production)
WHATSAPP_VERIFY_TOKEN=your_verify_token
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_id
